# Environment files — never commit secrets
.env
**/.env
**/*.env

# Runtime outputs and reports (generated per test run)
OUTPUTS/

# Python cache
__pycache__/
**/__pycache__/
*.pyc

# Binary input files — git tracks folder structure via .gitkeep
